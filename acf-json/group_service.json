    {
        "key": "group_service_packages",
        "title": "Service Packages",
        "fields": [
            {
                "key": "field_packages",
                "label": "Packages",
                "name": "packages",
                "type": "repeater",
                "collapsed": "field_package_name",
                "min": 1,
                "max": 10,
                "layout": "block",
                "button_label": "Add Package",
                "sub_fields": [
                    {
                        "key": "field_package_name",
                        "label": "Package Name",
                        "name": "package_name",
                        "type": "text",
                        "required": 1,
                        "placeholder": "Light Package"
                    },
                    {
                        "key": "field_package_tier",
                        "label": "Package Tier",
                        "name": "package_tier",
                        "type": "select",
                        "required": 1,
                        "choices": {
                            "basic": "Basic",
                            "standard": "Standard",
                            "premium": "Premium",
                            "ultimate": "Ultimate"
                        }
                    },
                    {
                        "key": "field_package_description",
                        "label": "Package Description",
                        "name": "package_description",
                        "type": "text",
                        "placeholder": "Double layer nano ceramic coating"
                    },
                    {
                        "key": "field_package_recommended",
                        "label": "Recommended Package",
                        "name": "package_recommended",
                        "type": "true_false",
                        "default_value": 0,
                        "message": "Mark as recommended package"
                    },
                    {
                        "key": "field_vehicle_sizes",
                        "label": "Vehicle Sizes & Pricing",
                        "name": "vehicle_sizes",
                        "type": "repeater",
                        "min": 5,
                        "max": 5,
                        "layout": "row",
                        "sub_fields": [
                            {
                                "key": "field_size_label",
                                "label": "Size",
                                "name": "size_label",
                                "type": "select",
                                "required": 1,
                                "choices": {
                                    "small": "Small (City Car)",
                                    "medium": "Medium (Sedan/SUV)",
                                    "large": "Large (Large SUV)",
                                    "xlarge": "X-Large (MPV)",
                                    "super": "Super (Luxury)"
                                }
                            },
                            {
                                "key": "field_price",
                                "label": "Price",
                                "name": "price",
                                "type": "number",
                                "required": 1,
                                "thousand_separator": ",",
                                "prepend": "IDR"
                            }
                        ]
                    },
                    {
                        "key": "field_package_features",
                        "label": "Package Features",
                        "name": "package_features",
                        "type": "repeater",
                        "button_label": "Add Feature",
                        "sub_fields": [
                            {
                                "key": "field_feature",
                                "label": "Feature",
                                "name": "feature",
                                "type": "text",
                                "required": 1
                            }
                        ]
                    },
                    {
                        "key": "field_package_durability",
                        "label": "Durability",
                        "name": "package_durability",
                        "type": "text",
                        "placeholder": "1-2 years"
                    },
                    {
                        "key": "field_package_maintenance",
                        "label": "Maintenance",
                        "name": "package_maintenance",
                        "type": "text",
                        "placeholder": "1 year member maintenance"
                    },
                    {
                        "key": "field_package_workmanship",
                        "label": "Workmanship Time",
                        "name": "package_workmanship",
                        "type": "text",
                        "placeholder": "3-4 days"
                    }
                ]
            }
        ],
        "location": [
            [
                {
                    "param": "post_type",
                    "operator": "==",
                    "value": "service"
                }
            ]
