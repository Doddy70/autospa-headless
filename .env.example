# AutoSPA frontend - local environment
#
# Copy .env.example to .env.local and adjust. .env.local is gitignored.

# ---------------------------------------------------------------------------
# WordPress origins
# ---------------------------------------------------------------------------

# The CMS origin of this project is the STAGING install:
#
#   https://backend.autospajakarta.com
#
# The production site (https://autospajakarta.com) is NOT queried any more -
# nothing in this app reads from it. The frontend only ever issues GET
# requests; the CMS stays read-only.
#
# The staging host routes WordPress through `index.php`, so the GraphQL and
# REST endpoints live behind that file instead of behind `/graphql` and
# `/wp-json` (nginx answers 404 on those two paths).
#
#   GraphQL : POST https://backend.autospajakarta.com/index.php?graphql
#   REST    : GET  https://backend.autospajakarta.com/index.php?rest_route=/wp/v2
WORDPRESS_GRAPHQL_URL=https://backend.autospajakarta.com/index.php?graphql
WORDPRESS_REST_URL=https://backend.autospajakarta.com/index.php?rest_route=/wp/v2
WORDPRESS_SITE_URL=https://backend.autospajakarta.com

# Public site origin, used for canonical URLs and JSON-LD @id values.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ---------------------------------------------------------------------------
# Beauty Care popout
# ---------------------------------------------------------------------------

# The site wide master switch of the AutoSPA Beauty Care popout. Set it to
# `false` to take the popout off the site for every visitor - the switch in
# the header and the switch in the mobile menu are then hidden as well.
#
# `POPUP_ENABLED` is read on the server at runtime, so the campaign can be
# switched off without a rebuild: change the variable and restart the server
# (or redeploy). `NEXT_PUBLIC_POPUP_ENABLED` is the fallback for setups that
# can only change the environment at build time.
#
# A visitor can also switch the popout off for their own browser (the bell in
# the header, the switch in the mobile menu) or for a single visit with
# `?popup=off` on any URL.
POPUP_ENABLED=true
NEXT_PUBLIC_POPUP_ENABLED=true

# Seconds before an ISR page is considered stale. Phase 1C section 7 calls
# on-demand revalidation via webhook; this is the time-based safety net.
WORDPRESS_REVALIDATE_SECONDS=300

# WordPress MCP (Model Context Protocol) - staging backend.
# WP_MCP_AUTH is the base64 of "<wp-user>:<application-password>".
# It is read by .mcp.json and .vscode/mcp.json, so export it in your shell:
#   export WP_MCP_AUTH=$(printf 'Official Website:<app-password>' | base64 -w0)
WP_MCP_AUTH=
