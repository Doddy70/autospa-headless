# AutoSPA frontend - local environment
#
# Copy to .env.example to .env.local and adjust. .env.local is gitignored.

# ---------------------------------------------------------------------------
# WordPress origins
# ---------------------------------------------------------------------------

# GraphQL endpoint used by the service/location repositories.
# NOTE: the staging host currently has no reachable /graphql route (nginx
# returns 404 and WPGraphQL does not answer on index.php either), so this
# points at production. The frontend only ever issues queries, never
# mutations - production stays read-only.
WORDPRESS_GRAPHQL_URL=https://autospajakarta.com/graphql

# REST endpoint used by the article (blog) APIs: /api/articles,
# /api/articles/<slug>, /api/categories. Same read-only rule applies.
WORDPRESS_REST_URL=https://autospajakarta.com/wp-json

# Origin of the WordPress install the content is mirrored from. Used to
# rewrite upload URLs to the local copies in public/wp-content.
WORDPRESS_SITE_URL=https://autospajakarta.com

# Public site origin, used for canonical URLs and JSON-LD @id values.
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Seconds before an ISR page is considered stale. Phase 1C section 7 calls for
# on-demand revalidation via webhook; this is the time-based safety net.
WORDPRESS_REVALIDATE_SECONDS=300

# WordPress MCP (Model Context Protocol) - production backend.
# WP_MCP_AUTH is the base64 of "<wp-user>:<application-password>".
# It is read by .mcp.json and .vscode/mcp.json, so export it in your shell:
#   export WP_MCP_AUTH=$(printf 'Official Website:<app-password>' | base64 -w0)
WP_MCP_AUTH=
