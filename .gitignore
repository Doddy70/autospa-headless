# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Claude
.claude/
.remember/

# Archives and unrelated docs
archived/
Materi\ Raw/

# Third-party WordPress plugin working copies (never committed - these are
# vendor distributions, not application source).
# elementor-pro/ came from a "nulled" redistribution whose entry file had a
# tampered backdoor; the injection has been removed. See the security notes
# in docs/ before re-adding it.
elementor-pro/

# Reference snapshots (not part of the app - must stay out of public/ so they
# are never served statically or bundled into the deployment)
_reference/
agntix/

# Third-party templates evaluated but not adopted.
# magic-headless-wp-main/ is a Vite + Cloudflare Pages demo (bigscoots/
# magic-headless-wp) that was reviewed for the headless architecture. It has
# its own package.json/tsconfig and breaks the Next.js build; keep it out.
magic-headless-wp-main/

# WordPress endpoint-probing helpers and raw payload dumps (local tooling).
# These scripts talk to a live WordPress install and some of them can mint
# application passwords - they must never reach the repository.
.probe*.php
.mkpw.php
.extract*.php
.slugs.php
*.extract.err
.content*.json
.pf*.json
.pages.json
.prod-*.json
.users.json
.types.json
.wpjson.json
.gq.json
.mcp-*.json

# Scratch output from the content extraction run.
Beauty Care Campaign/

# One-off Playwright debugging scripts (they hardcode absolute paths to a
# specific machine and port). The reusable checks live in scripts/sync/.
verify-hero.js
verify-shots/

# WordPress core assets copied out of the production site. The mirrored pages
# reference /wp-content/ (rebuilt by `npm run sync:content`) but never
# /wp-includes/, so this copy is unused third-party code.
public/wp-includes/

# Secrets and local environment
# .key.md held root SSH passwords + a private SSH key. It was never committed,
# but keep it out of the working tree so it can never be staged by accident.
.key.md
*.key
*.pem
credentials*.json
service-account*.json
.env
.env.local
.env.*.local
!.env.example

# Build output and dependencies
node_modules/
.next/
.next-wizard/
.next-build/
.next-dev/
.next-ba/
.next-deploy/
out/
next-env.d.ts
test-results/
playwright-report/
tsconfig.tsbuildinfo

# Scratch output of the browser checks and the screenshots they take.
tmp/

# WordPress mirror - regenerated by `npm run sync:content`.
# The mirrored Elementor assets and media are ~30 MB of binaries; they are
# rebuilt from the WordPress origin instead of being committed.
public/wp-content/

# Sync cache (raw REST payloads, mirrored page HTML, screenshots)
.cache/

# OS files in subdirectories
**/.DS_Store
